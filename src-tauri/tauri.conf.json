{
  "$schema": "https://raw.githubusercontent.com/nicepkg/tauri-schemas/refs/heads/master/tauri.v2.conf.json",
  "productName": "LYNQ Communication",
  "version": "0.1.0",
  "identifier": "com.lynq.communication",
  "build": {
    "beforeDevCommand": "npm run dev --prefix packages/web-ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix packages/web-ui",
    "frontendDist": "../packages/web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LYNQ Communication",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ws: http: data: blob: 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Chat",
    "shortDescription": "Ultra-fast local network communication platform",
    "longDescription": "LYNQ is an open-source, local-first communication and media sharing application inspired by WhatsApp and Telegram."
  }
}
